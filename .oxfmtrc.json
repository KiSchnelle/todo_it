{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": ["dist", "out", ".vscode-test", "node_modules", ".claude", "package-lock.json", "CHANGELOG.md", "README.md"]
}
